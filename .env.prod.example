# Production environment variables. Copy to .env.prod, fill in real values, never commit it.
# Spring's relaxed binding maps SCREAMING_SNAKE_CASE -> the dotted property (e.g. JWT_SECRET -> jwt.secret).

SPRING_PROFILES_ACTIVE=prod
PORT=8080
# JVM heap — cap it so the API shares VPS RAM with Postgres/other services
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/gymbro
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<db-password>

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=<random-256-bit-secret>
JWT_ACCESS_TOKEN_EXPIRATION_MS=1800000
JWT_REFRESH_TOKEN_EXPIRATION_MS=2592000000

# Mail
SPRING_MAIL_HOST=<smtp-host>
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<smtp-username>
SPRING_MAIL_PASSWORD=<smtp-password>
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_FROM=<smtp-username>

# CORS — comma-separated list of allowed origin patterns, no wildcarded scheme/host in prod
APP_CORS_ALLOWED_ORIGINS=https://app.example.com

# AWS S3 — prefer an IAM instance/task role over static keys where the deploy target allows it
AWS_REGION=<aws-region>
AWS_ACCESSKEYID=<aws-access-key-id>
AWS_SECRETKEY=<aws-secret-key>
CLOUD_AWS_S3_BUCKET=<bucket-name>
DEFAULT_PROFILE_IMAGE_KEY=images/default-profile.png

# Multipart upload limits
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB
