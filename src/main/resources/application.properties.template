spring.application.name=
server.servlet.context-path=/api

# database
spring.datasource.url=
spring.datasource.username=
spring.datasource.password=
spring.jpa.show-sql=
spring.jpa.hibernate.ddl-auto=validate
# No open-session-in-view: services are @Transactional(readOnly = true) by default, so DTO
# mapping happens inside the transaction and the DB connection is released before rendering.
spring.jpa.open-in-view=false
# Lazy collections/proxies of a list load in batches (IN queries), not one query per row (N+1)
spring.jpa.properties.hibernate.default_batch_fetch_size=50

# flyway
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

# graphiql
spring.graphql.graphiql.enabled=true
spring.graphql.graphiql.path=/graphiql

# jackson
spring.jackson.serialization.write-dates-as-timestamps=false
spring.jackson.date-format=yyyy-MM-dd
spring.jackson.time-zone=UTC

# mail
spring.mail.host=
spring.mail.port=
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=
spring.mail.properties.mail.smtp.starttls.enable=
spring.mail.properties.mail.smtp.from=

# jwt
jwt.secret=
jwt.access-token-expiration-ms=1800000
jwt.refresh-token-expiration-ms=2592000000

# cors
app.cors.allowed-origins=http://localhost:*

# openapi
springdoc.swagger-ui.path=
springdoc.api-docs.path=
springdoc.api-docs.enabled=
springdoc.swagger-ui.enabled=

# aws
aws.region=
aws.secretKey=
aws.accessKeyId=
cloud.aws.s3.bucket=
default.profile.image.key=

# pagination — caps @PageableDefault Pageable size on REST
spring.data.web.pageable.max-page-size=100

# multipart
spring.servlet.multipart.max-file-size=
spring.servlet.multipart.max-request-size=

# actuator
management.endpoints.web.exposure.include=health,info