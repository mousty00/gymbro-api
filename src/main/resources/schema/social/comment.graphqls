extend type Query {
    comments(page: Int, size: Int): CommentConnection
    comment(id: UUID): CommentDTO
}

extend type Mutation {
    deleteComment(id: UUID): MessageResponse
    createComment(request: CommentInput): CommentEntityResponse
}

type CommentDTO {
    id: UUID
    postId: UUID
    user: UserDTO
    content: String
    createdAt: String
}

input CommentInput {
    postId: UUID!
    content: String!
}

type SimpleCommentDTO {
    id: UUID
    postId: UUID
    username: String
    content: String
    createdAt: String
}

type CommentConnection implements Connection {
    pageInfo: PageInfo!
    totalCount: Int!
    results: [CommentDTO]
}

type CommentEntityResponse implements EntityResponse {
    message: String
    timestamp: String
    result: CommentDTO
}
